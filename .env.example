# ── SUPABASE ──────────────────────────────────────────────────────────────────

# SUPABASE_URL: URL project Supabase Anda
SUPABASE_URL=""
# SUPABASE_ANON_KEY: Public anon key untuk client browser
SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY: Service role key untuk operasi server-side
SUPABASE_SERVICE_ROLE_KEY=""

# DATABASE_URL: koneksi PostgreSQL untuk migration CLI
DATABASE_URL=""

# DB_AUTO_MIGRATE: jalankan migrasi pending otomatis saat server start
DB_AUTO_MIGRATE="true"
