# ── SUPABASE ──────────────────────────────────────────────────────────────────

# Client-side (Next.js client / browser)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-side (server/config.ts, API routes, Edge Functions)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── DATABASE ─────────────────────────────────────────────────────────────────

# DATABASE_URL: koneksi PostgreSQL untuk migration CLI
DATABASE_URL=""

# DB_AUTO_MIGRATE: jalankan migrasi pending otomatis saat server start
DB_AUTO_MIGRATE="true"

# ── AI (OPTIONAL) ────────────────────────────────────────────────────────────

# GEMINI_API_KEY: untuk fitur AI Barber Consultant
GEMINI_API_KEY=""
