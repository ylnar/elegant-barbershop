# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# SUPABASE_URL: URL Project Supabase Anda (misal: https://xyzcompany.supabase.co)
SUPABASE_URL=""
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public Anon Key untuk client browser
SUPABASE_ANON_KEY=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Service role key untuk operasi server-side penuh (jangan dibuka di client)
SUPABASE_SERVICE_ROLE_KEY=""

# DATABASE_URL: koneksi PostgreSQL untuk migration CLI (npm run db:migrate).
# TIDAK PERLU DIISI MANUAL — otomatis tersusun & tersimpan oleh sistem
# begitu SUPABASE_DB_PASSWORD di bawah terisi.
DATABASE_URL=""

# SUPABASE_DB_PASSWORD: password database Supabase Anda.
# Ambil di: Supabase Dashboard > Project Settings > Database > Database password
# Cukup isi INI SAJA — host/region dideteksi otomatis, lalu hasilnya
# disimpan ke DATABASE_URL di atas secara permanen.
SUPABASE_DB_PASSWORD=""

# DB_AUTO_MIGRATE: jalankan migrasi pending otomatis saat server start.
DB_AUTO_MIGRATE="true"
