# ── MONGODB ─────────────────────────────────────────────────────────────────
#
# MONGODB_URI: connection string MongoDB.
#   - Local  : mongodb://localhost:27017/elegant_barbershop
#   - Atlas  : mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/elegant_barbershop
#
# MONGODB_URI="mongodb://localhost:27017/elegant_barbershop"

# Nama database MongoDB (opsional, default diambil dari URI)
MONGODB_DB_NAME="elegant_barbershop"

# Timeout koneksi (ms)
MONGODB_CONNECT_TIMEOUT_MS="8000"

# Auto-seed data awal (services/barbers/settings) bila koleksi kosong
MONGODB_AUTO_SEED="true"

# ── JWT (MOBILE AUTH) ───────────────────────────────────────────────────────

# JWT_SECRET: secret key untuk sign/verify JWT token (Android app).
# GANTI di production! Minimal 32 karakter.
JWT_SECRET="elegant-barbershop-jwt-secret-change-in-production"

# ── AI (OPTIONAL) ────────────────────────────────────────────────────────────

# GEMINI_API_KEY: untuk fitur AI Barber Consultant
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"